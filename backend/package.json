{
  "name": "elegance-backend",
  "version": "1.0.0",
  "description": "Backend API for Élégance e-commerce platform - Tunisian fashion boutique",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seeder.js",
    "seed:import": "node utils/seeder.js -i",
    "seed:delete": "node utils/seeder.js -d",
    "seed:testimonials": "node seeds/seedTestimonials.js",
    "seed:contacts": "node seeds/seedContacts.js",
    "seed:collections": "node seeds/seedCollections.js",
    "seed:categories": "node seeds/seedCategories.js",
    "seed:banners": "node seeds/seedBanners.js",
    "seed:products": "node seeds/seedProducts.js",
    "seed:carts": "node seeds/seedCarts.js",
    "seed:orders": "node seeds/seedOrders.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "fashion",
    "tunisia"
  ],
  "author": "Redix Digital Solution",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.1",
    "colors": "^1.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
